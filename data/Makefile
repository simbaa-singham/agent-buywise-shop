# data module: seed data, knowledge documents and eval sets (generated by data/tools).
PY := tools/.venv/bin/python

.PHONY: help tools generate

help:
	@grep -E '^[a-z-]+:.*?## ' $(MAKEFILE_LIST) | sed 's/:.*## /\t/'

tools: ## Create the data-generation virtualenv (tools/.venv)
	python3 -m venv tools/.venv && $(PY) -m pip install -q -r tools/requirements.txt

generate: ## Regenerate catalog, seed data, knowledge docs and eval sets (deterministic content)
	$(PY) tools/build_catalog.py
	$(PY) tools/generate_seed.py
	cd tools && .venv/bin/python build_documents.py
	$(PY) tools/build_evals.py
