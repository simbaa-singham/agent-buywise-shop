# All model calls go through the LiteLLM gateway (ADR-026)
LLM_GATEWAY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-buywise-local
LLM_PRIMARY_MODEL=buywise-primary
EMBED_MODEL=bge-m3
# Agent database (ADR-010): pgvector chunks for RAG (ADR-011)
DATABASE_URL=postgresql://agent:agent-local@localhost:5432/agent
# Conversation streams (ADR-029)
REDIS_URL=redis://localhost:6379/0
# Tools
MCP_URL=http://localhost:8090/mcp
SERVICES_URL=http://localhost:8081
