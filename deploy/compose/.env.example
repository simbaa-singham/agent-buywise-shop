# Local development secrets only. Copy to .env (git-ignored): cp .env.example .env
POSTGRES_PASSWORD=postgres-local
SERVICES_DB_PASSWORD=services-local
AGENT_DB_PASSWORD=agent-local
KEYCLOAK_DB_PASSWORD=keycloak-local
LITELLM_DB_PASSWORD=litellm-local
KEYCLOAK_ADMIN_PASSWORD=admin-local
LITELLM_MASTER_KEY=sk-buywise-local

# Optional: keep Postgres data files in a host folder outside the repo (bind mount).
# Unset = Docker-managed volume. Never edit this folder while Postgres runs; exclude it from Time Machine.
# PG_DATA_DIR=/Users/<you>/AI/Production/buywise-data/postgres

# Local test login (make demo-user): Keycloak client secret for the BFF and the demo customer's password
CUSTOMER_WEB_CLIENT_SECRET=customer-web-local-secret
DEMO_CUSTOMER_PASSWORD=demo-local-123
