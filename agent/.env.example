# All model calls go through the LiteLLM gateway (ADR-026)
LLM_GATEWAY_URL=http://localhost:4000
LLM_PRIMARY_MODEL=buywise-primary
LLM_ECONOMY_MODEL=buywise-economy
EMBED_MODEL=nomic-embed-text
# Agent database (ADR-010)
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent
# Conversation streams and budget counters (ADR-026, ADR-029)
REDIS_URL=redis://localhost:6379/0
